---
layout: nil
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for post in site.posts %}{% unless post.sitemap == false %}
<url>
<loc>{{ site.url }}{{ post.url }}</loc>
<lastmod>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
</url>
{% endunless %}{% endfor %}
{% for node in site.pages %}{% unless node.sitemap == false or node.url contains '/page' or node.url == '/404.html' %}{% assign ext = node.url | split: '.' | last %}{% if node.url == '/' or ext == 'html' or ext == node.url %}
<url>
<loc>{{ site.url }}{{ node.url | replace: '/index.html', '/' }}</loc>{% if node.last_modified_at %}
<lastmod>{{ node.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
</url>
{% endif %}{% endunless %}{% endfor %}
{% for file in site.static_files %}{% if file.extname == '.html' %}
<url>
<loc>{{ site.url }}{{ file.path | replace: '/index.html', '/' }}</loc>
</url>
{% endif %}{% endfor %}
</urlset>
